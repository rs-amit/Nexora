PORT=5002

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sketchboard-prod

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

AUTH_SERVICE=https://auth.yourapp.internal
ROOM_SERVICE=https://room.yourapp.internal
CHAT_SERVICE=https://chat.yourapp.internal
SKETCH_SERVICE=https://sketch.yourapp.internal
WORKSPACE_SERVICE=https://workspace.yourapp.internal
FRONTEND_URL=https://yourapp.vercel.app

EMAIL_USER=replace-with-a-real-sender-address
EMAIL_PASS=replace-with-a-real-app-password

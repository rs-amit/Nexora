PORT=5005

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sketchboard-prod

AUTH_SERVICE=https://auth.yourapp.internal
ROOM_SERVICE=https://room.yourapp.internal
CHAT_SERVICE=https://chat.yourapp.internal
SKETCH_SERVICE=https://sketch.yourapp.internal
FRONTEND_URL=https://yourapp.vercel.app

# NOTE: this service trusts an `x-user-id` header with no signature
# verification of its own — it must only ever be reachable from the
# api-gateway (and the other internal services' membership checks), never
# given a public-facing URL. See the auth.middleware.js in this service.
